---
import PageLayout from '../layouts/PageLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SocialLinks from '../components/SocialLinks.astro';

const projects = [
  {
    title: 'TravelEA',
    description: 'TravelEa is my current whole year project I am working on at university. It is a web application that is designed for people wanting to organise and plan trips around the world and to meet people to travel with. The project is being developed using Play, Scala, Java, Javascript and Ebeans frameworks for a full stack web development process. This is still a work in progress and will be completed by the end of the year. I am working in an agile environment (Scrum) with a team of 8 and a scrum master and product owner.',
    image: '/images/projects/travelea.png',
    links: [],
  },
  {
    title: 'Auction API & Webapp',
    description: 'This project was a full stack development of an auction website similar to trademe. I developed a RESTful API with endpoints for functionality such as account authentication, logins, creating and editing auctions, uploading photos and more. This was my first experience with client server architecture and I\'m happy and grateful about how much I\'ve learned and how it has made me passionate about web development! The backend server is built using Node.js and Express.js connected to a MySql database. Vue.js and Javascript is used to create the frontend.',
    image: '/images/projects/auction.png',
    links: [
      { label: 'Github (Backend)', url: 'https://github.com/cllaw/SENG365-API' },
      { label: 'Github (Frontend)', url: 'https://github.com/cllaw/SENG365-Frontend' },
    ],
  },
  {
    title: 'Alien Invasion Computer Graphics',
    description: 'This program is a fully computer generated scene of various models and features with an alien invasion theme using OpenGL and C++ frameworks. I loved this project as I was never good artistically so it was very enjoyable to be creative and learn how to make computers create such cool looking things. The scene includes shadow & lighting, skyboxes & textures, generated models and timer functions that enabled real time animation and effects.',
    image: '/images/projects/alien.png',
    links: [
      { label: 'Github', url: 'https://github.com/cllaw/SENG365-API' },
      { label: 'Report', url: 'https://docs.google.com/document/d/1FTDz0vi-IPSncXX0fMkiTeEuTeFb7y4S5Y9sGYWBDEg/edit?usp=sharing' },
    ],
  },
  {
    title: 'UCFunkit Catch Game',
    description: 'A two person group project written in C. Made on a micro controller with a ATmega32U2 microchip. This game allows players to choose different throwing speeds and move where they want to throw and catch the ball. It was modelled after a paddle and catch game. This was a very fun project to work on as it had infrared connectivity between the two micro controllers and played a victory sound which we generated ourselves. It also let us be creative by designing and implementing exactly how the game would flow on two different devices and what each display would show as the game ran.',
    image: '/images/projects/ucfk.jpg',
    links: [
      { label: 'Github', url: 'https://github.com/cllaw/ENCE260' },
    ],
  },
  {
    title: 'Petville Group Project',
    description: 'A two person group project written in Java. It is modelled of the popular Tamagotchi games. In the game up to 3 players can own up to 3 pets and must look after them with the objective of keeping them happy and healthy. You can do this by buying food and toys to play and feed with them respectively and train them to become better pets. At the end of the game, each player receives a scored based on how well they looked after their pets. The player with the highest score wins the game.',
    image: '/images/projects/pet2.png',
    links: [
      { label: 'Github', url: 'https://github.com/cllaw/SENG201' },
      { label: 'JAR', url: 'https://drive.google.com/open?id=1WPm8eKKQGipZY1mRm9sJ_5u3VLkFm1kt' },
    ],
  },
];
---

<PageLayout title="Projects | Chuan Law" description="Featured projects by Chuan Law">
  <HeroSection
    backgroundImage="/images/hero/osaka-hotel.jpg"
    title="Projects"
  />

  <div class="content">
    {projects.map(project => (
      <ProjectCard
        title={project.title}
        description={project.description}
        image={project.image}
        links={project.links}
      />
    ))}

    <section class="connect">
      <h3 class="section-heading">Connect with me!</h3>
      <div class="divider"></div>
      <SocialLinks />
      <div class="divider"></div>
    </section>
  </div>
</PageLayout>

<style>
  .content {
    max-width: 900px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
  }

  .connect {
    text-align: center;
    padding: 2rem 0 1rem;
  }

  .divider {
    border-bottom: 1px solid var(--color-primary);
    width: 50%;
    margin: 1rem auto;
  }

  @media (max-width: 640px) {
    .content {
      padding: 1rem;
    }
  }
</style>
