---
import PageLayout from '../../layouts/PageLayout.astro';
import GalleryCard from '../../components/GalleryCard.astro';

const items = [
  { title: 'Japan', image: '/images/blog/travel-2018/IMG_6298-min.JPG', href: '/blog/japan-2018' },
  { title: 'Queenstown', image: '/images/blog/travel-2018/IMG_3923-min.jpg', href: '/blog/queenstown-2018' },
  { title: 'Everyday', image: '/images/blog/travel-2018/csse.jpg' },
  { title: 'Other', image: '/images/blog/travel-2018/flower-car.jpg' },
];
---

<PageLayout title="2018 | Blog | Chuan Law" description="Travel photos and stories from 2018">
  <header class="gallery-hero">
    <a href="/blog" class="hero-link">2018</a>
  </header>

  <div class="gallery-grid">
    {items.map(item => (
      <GalleryCard title={item.title} image={item.image} href={item.href} />
    ))}
  </div>
</PageLayout>

<style>
  .gallery-hero {
    background-image: url('/images/hero/IMG_9923.jpg');
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .hero-link {
    color: #fff;
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    text-decoration: none;
  }

  .hero-link:hover {
    color: #ddd;
    text-decoration: none;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4px;
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: 1fr;
      padding: 1rem;
    }
  }
</style>
