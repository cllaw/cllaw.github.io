---
interface Props {
  layout?: 'full' | 'half' | 'custom';
}
---

<div class="photo-grid">
  <slot />
</div>

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin: 1.5rem 0;
  }

  .photo-grid :global(.full) {
    grid-column: 1 / -1;
  }

  .photo-grid :global(img) {
    width: 100%;
    height: auto;
    border-radius: 4px;
    object-fit: cover;
  }

  @media (max-width: 480px) {
    .photo-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
