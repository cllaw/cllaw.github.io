---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/', label: 'About Me' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
];
---

<nav class="navbar">
  <div class="nav-inner">
    <a href="/" class="nav-brand">Chuan Law</a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation">
      <span></span>
      <span></span>
      <span></span>
    </label>
    <ul class="nav-links">
      {links.map(link => (
        <li>
          <a
            href={link.href}
            class:list={[{ active: currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-nav);
    padding: 0.75rem 1.5rem;
  }

  .nav-inner {
    max-width: var(--max-width-page);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
  }

  .nav-brand {
    color: #fff;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  .nav-brand:hover {
    color: #ddd;
    text-decoration: none;
  }

  .nav-toggle {
    display: none;
  }

  .nav-toggle-label {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 4px;
  }

  .nav-toggle-label span {
    display: block;
    width: 24px;
    height: 2px;
    background: #fff;
    transition: transform 0.3s, opacity 0.3s;
  }

  .nav-links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.25rem;
  }

  .nav-links a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    border-radius: 4px;
    transition: color 0.2s;
    font-size: 0.95rem;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: #fff;
  }

  @media (max-width: 640px) {
    .nav-toggle-label {
      display: flex;
    }

    .nav-links {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      padding-top: 0.75rem;
    }

    .nav-toggle:checked ~ .nav-links {
      display: flex;
    }

    .nav-toggle:checked ~ .nav-toggle-label span:nth-child(1) {
      transform: rotate(45deg) translate(5px, 5px);
    }
    .nav-toggle:checked ~ .nav-toggle-label span:nth-child(2) {
      opacity: 0;
    }
    .nav-toggle:checked ~ .nav-toggle-label span:nth-child(3) {
      transform: rotate(-45deg) translate(5px, -5px);
    }

    .nav-links a {
      padding: 0.5rem 0;
    }
  }
</style>
